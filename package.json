{
  "name": "blockshot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shooter multijugador estilo arena para jugar en clase (LAN)",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"pnpm --filter @blockshot/server dev\" \"pnpm --filter @blockshot/client dev\"",
    "build": "pnpm -r build",
    "start": "pnpm --filter @blockshot/server start",
    "clase": "pnpm build && pnpm start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.14.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yaml,yml}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
